# Example configuration for my_wayland.
# Copy to:  ~/.config/my_wayland/config.toml
#     or:  $XDG_CONFIG_HOME/my_wayland/config.toml

[general]
cursor_theme = "default"
cursor_size = 24

# Tiling gaps (logical pixels). Outer gap shrinks the tiling region inside the usable area;
# inner gap is space between sibling tiles. Fullscreen ignores gaps.
outer_gap = 0
inner_gap = 0

# Decoration insets (logical pixels): frame rect minus these edges is the tiled client content
# rect for configure and root position. Keep at zero until server-side decorations are drawn.
[general.decoration_insets]
top = 0
right = 0
bottom = 0
left = 0

# XDG decoration mode when the client uses zxdg_toplevel_decoration_v1 (or not).
# Each key sets policy for: no CSD protocol, tiled, floating, fullscreen, or unset mode.
# Values: "server" (SSD), "client" (CSD), "honor-client" (prefer client preference).
# Defaults if this table is omitted: no_protocol=client, tiled=server, floating=honor-client,
# fullscreen=server, unset_mode=server.
[decorations.xdg]
no_protocol = "client"
tiled = "server"
floating = "honor-client"
fullscreen = "server"
unset_mode = "server"

[bindings]
# Key names follow xkb (e.g. Super, Ctrl, Alt, Shift). Last segment is the key.
"Super+Escape" = { action = "quit" }
"Super+Shift+C" = { action = "reload-config" }
"Super+Return" = { action = "spawn", command = "alacritty" }

[mouse_bindings]
# Mouse bindings use modifier names plus `mouse:<button>`.
# Supported button aliases: left, right, middle. Raw Linux button codes also work.
"Ctrl+mouse:left" = { action = "move-window" }
"Ctrl+mouse:right" = { action = "resize-window" }

# Optional: fixed scale per DRM output name, or "auto".
# [output.scales]
# "DP-1" = "auto"
# "eDP-1" = 1.25
